# Secrets: local env files are never committed (ARCHITECTURE.md section 13.2).
.env
# Compiled binary and build output.
/rootcause
/bin/
# Go test binaries.
*.test
# dbt output. The container writes it to /tmp, so these exist only after a
# dbt run on the host.
/dbt/target/
/dbt/logs/
# Dashboard build: npm installs into node_modules, and scripts/build-web.sh
# writes dist, which `go build -tags webdist` embeds.
/web/node_modules/
/web/dist/
