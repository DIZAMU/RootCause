#!/bin/sh
### BEGIN INIT INFO
# Provides:          lagerapp
# Required-Start:    $local_fs $network
# Required-Stop:     $local_fs
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: lagerapp warehouse stock service
### END INIT INFO

NAME=lagerapp
DAEMON=/usr/bin/python3
APP=/opt/lagerapp/app.py
PIDFILE=/run/lagerapp.pid
USER=lagerapp

# shellcheck source=/dev/null # provided by the target system
. /lib/lsb/init-functions

case "$1" in
  start)
    log_daemon_msg "Starting $NAME"
    start-stop-daemon --start --quiet --background --make-pidfile --pidfile "$PIDFILE" \
        --chuid "$USER" --startas "$DAEMON" -- "$APP"
    log_end_msg $?
    ;;
  stop)
    log_daemon_msg "Stopping $NAME"
    start-stop-daemon --stop --quiet --retry 5 --remove-pidfile --pidfile "$PIDFILE"
    rc=$?
    # 1 means it was not running, which is fine for stop.
    [ "$rc" -eq 1 ] && rc=0
    log_end_msg "$rc"
    ;;
  restart)
    "$0" stop
    "$0" start
    ;;
  status)
    status_of_proc -p "$PIDFILE" "$DAEMON" "$NAME"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart|status}" >&2
    exit 3
    ;;
esac
